[Unit]
Description=MnT Unattended Market Alert Worker
After=network-online.target hanif-dashboard.service
Wants=network-online.target

[Service]
Type=simple
User=airomair
Group=airomair
WorkingDirectory=/home/airomair/Hanif-Trading-Suite-Pro/dashboard
# Shared credentials/settings remain authoritative; MnT-only settings may override below.
EnvironmentFile=-/home/airomair/Kronos/.env
EnvironmentFile=-/home/airomair/Hanif-Trading-Suite-Pro/dashboard/mnt.env
ExecStart=/home/airomair/kronos-venv/bin/python /home/airomair/Hanif-Trading-Suite-Pro/dashboard/mnt_alert_supervisor.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
