# Keep real credentials on the server only. Never put these in static/app.js.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
KRONOS_API_URL=http://127.0.0.1:8000

# MnT Gamma + options-flow layers. `auto` uses the configured deployable provider.
# Unusual Whales API tokens must remain server-side. The ChatGPT connector is not
# automatically available to this standalone FastAPI service; the server needs its
# own authorized API token if these live layers are enabled.
MNT_GAMMA_PROVIDER=auto
MNT_FLOW_PROVIDER=auto
UNUSUAL_WHALES_API_TOKEN=
MNT_GAMMA_CACHE_SECONDS=60
MNT_FLOW_CACHE_SECONDS=30

# MnT server-side setup review gates. These do not authorize or place orders.
MNT_MIN_REVIEW_SCORE=62
MNT_MIN_REVIEW_COVERAGE=55
MNT_NO_CHASE_ATR=0.25
MNT_SETUP_TTL_MINUTES=10

# MnT signal history + outcome calibration. SQLite is enabled by default so the
# score can be compared with its own later 1h/2h outcomes.
MNT_SIGNAL_DB_ENABLED=true
# MNT_SIGNAL_DB=/home/airomair/mnt-data/mnt_signals.sqlite3
# Repeated Analyze clicks should not create fake extra observations.
MNT_SIGNAL_DEDUPE_MINUTES=5
MNT_SIGNAL_DEDUPE_SCORE_DELTA=3

# Shadow calibration safeguards. Historical outcomes may recommend a stricter
# review score, but MnT does not automatically change the live gate or Fusion weights.
MNT_CALIBRATION_MIN_RESOLVED=30
MNT_CALIBRATION_TARGET_WIN_RATE=55
MNT_LAYER_SUPPORTIVE_SCORE=60
MNT_LAYER_MIN_SAMPLES=10

# READY alerts that survive ranking are also written to a separate shadow journal.
# This measures exactly what the alert system surfaced without placing brokerage orders.
MNT_SHADOW_TRADES_ENABLED=true
# MNT_SHADOW_TRADE_DB=/home/airomair/mnt-data/mnt_shadow_trades.sqlite3

# Unattended Discord scanner. PRE_TRIGGER alerts are deliberately earlier than
# CONFIRM so you can be ready before the price has already run through the entry.
MNT_DASHBOARD_API_URL=http://127.0.0.1:8080
MNT_DISCORD_WEBHOOK_URL=
MNT_ALERT_SYMBOLS=SPY,QQQ,NVDA,TSLA,AAPL,AMD,META,AMZN,MSFT,GOOGL,PLTR,COIN
MNT_ALERT_SCAN_SECONDS=60
# Fast /api/radar prefilters the universe; only this many symbols get full Fusion per scan.
MNT_FUSION_SHORTLIST=4
# Keep recently alerted PRE_TRIGGER names in the Fusion shortlist until they resolve.
MNT_STICKY_PRETRIGGER_LIMIT=2
MNT_PRETRIGGER_SCORE=72
MNT_PRETRIGGER_COVERAGE=55
MNT_ALERT_COOLDOWN_SECONDS=900
# Expire old lifecycle state so a prior-day alert cannot suppress a fresh setup.
MNT_ALERT_STATE_MAX_AGE_SECONDS=14400
# Rank the full Fusion shortlist before alerting. READY is prioritized over PRE_TRIGGER.
MNT_MAX_PRETRIGGER_ALERTS_PER_SCAN=3
MNT_MAX_READY_ALERTS_PER_SCAN=5
MNT_MAX_CONTRACT_COST=300
# Default scan window is 9:25 AM–4:05 PM ET. Values are minutes after midnight.
MNT_ALERT_START_MINUTE_ET=565
MNT_ALERT_END_MINUTE_ET=965
# MNT_ALERT_STATE_FILE=/home/airomair/mnt-data/mnt_alert_state.json
# Supervisor heartbeat used by `python mnt_status.py`.
# MNT_WORKER_STATUS_FILE=/home/airomair/mnt-data/mnt_worker_status.json
MNT_WORKER_STALE_SECONDS=180

# Kronos CSV timestamps without an explicit UTC offset are treated as market time.
MNT_BAR_TIMEZONE=America/New_York

# Optional comma-separated market-radar universe.
# RADAR_UNIVERSE=SPY,QQQ,IWM,DIA,NVDA,AMD,AAPL,MSFT,AMZN,META,GOOGL,TSLA
