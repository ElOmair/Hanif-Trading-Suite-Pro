# Keep real credentials on the server only. Never put these in static/app.js.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
KRONOS_API_URL=http://127.0.0.1:8000

# MnT Gamma + options-flow layers. `auto` uses the configured deployable provider.
# Unusual Whales API tokens must remain server-side. The ChatGPT connector is not
# automatically available to this standalone FastAPI service; the server needs its
# own authorized API token if these live layers are enabled.
MNT_GAMMA_PROVIDER=auto
MNT_FLOW_PROVIDER=auto
UNUSUAL_WHALES_API_TOKEN=
MNT_GAMMA_CACHE_SECONDS=60
MNT_FLOW_CACHE_SECONDS=30

# MnT signal history + outcome calibration. SQLite is enabled by default so the
# score can be compared with its own later 1h/2h outcomes.
MNT_SIGNAL_DB_ENABLED=true
# MNT_SIGNAL_DB=/home/airomair/mnt-data/mnt_signals.sqlite3

# Kronos CSV timestamps without an explicit UTC offset are treated as market time.
MNT_BAR_TIMEZONE=America/New_York

# Optional comma-separated market-radar universe.
# RADAR_UNIVERSE=SPY,QQQ,IWM,DIA,NVDA,AMD,AAPL,MSFT,AMZN,META,GOOGL,TSLA
