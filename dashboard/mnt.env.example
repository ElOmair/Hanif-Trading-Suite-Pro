# MnT-only overrides loaded after /home/airomair/Kronos/.env.
# Do not duplicate ALPACA_API_KEY, ALPACA_SECRET_KEY, or other shared credentials here.

# Optional professional market context.
MNT_GAMMA_PROVIDER=auto
MNT_FLOW_PROVIDER=auto
UNUSUAL_WHALES_API_TOKEN=
MNT_GAMMA_CACHE_SECONDS=60
MNT_FLOW_CACHE_SECONDS=30

# Server-side setup review gates. These never authorize brokerage orders.
MNT_MIN_REVIEW_SCORE=62
MNT_MIN_REVIEW_COVERAGE=55
MNT_NO_CHASE_ATR=0.25
MNT_SETUP_TTL_MINUTES=10

# Signal history and calibration.
MNT_SIGNAL_DB_ENABLED=true
# MNT_SIGNAL_DB=/home/airomair/mnt-data/mnt_signals.sqlite3
MNT_SIGNAL_DEDUPE_MINUTES=5
MNT_SIGNAL_DEDUPE_SCORE_DELTA=3
MNT_CALIBRATION_MIN_RESOLVED=30
MNT_CALIBRATION_TARGET_WIN_RATE=55
MNT_LAYER_SUPPORTIVE_SCORE=60
MNT_LAYER_MIN_SAMPLES=10

# Chronological Fusion-weight challenger. It can recommend a candidate only after
# training on older resolved signals and validating against later unseen signals.
# It never edits LAYER_WEIGHTS automatically.
MNT_WEIGHT_CHALLENGER_TRAIN_FRACTION=0.70
MNT_WEIGHT_CHALLENGER_MIN_RESOLVED=40
MNT_WEIGHT_CHALLENGER_MIN_HOLDOUT=12
MNT_WEIGHT_CHALLENGER_MIN_SELECTED=8
MNT_WEIGHT_CHALLENGER_MIN_LAYER_LIFT=8
MNT_WEIGHT_CHALLENGER_MIN_HOLDOUT_IMPROVEMENT=3

# READY-alert shadow journal + actual option quote marks.
MNT_SHADOW_TRADES_ENABLED=true
# MNT_SHADOW_TRADE_DB=/home/airomair/mnt-data/mnt_shadow_trades.sqlite3
# Blank uses Alpaca's account-default option feed. Set to opra or indicative to force one.
MNT_ALPACA_OPTION_FEED=
# Calibration summaries ignore horizon marks collected more than this many minutes late.
MNT_OPTION_MARK_MAX_LAG_MINUTES=10

# Session-level risk governor. Leave enforcement false while collecting shadow evidence.
MNT_SESSION_RISK_ENFORCE=false
MNT_SESSION_MAX_READY_ALERTS=8
MNT_SESSION_LOSS_HORIZON_MINUTES=60
MNT_SESSION_BAD_OPTION_RETURN_PCT=-25
MNT_SESSION_MAX_CONSECUTIVE_BAD_MARKS=3

# Unattended scanner / Discord lifecycle.
MNT_DASHBOARD_API_URL=http://127.0.0.1:8080
MNT_DISCORD_WEBHOOK_URL=
MNT_ALERT_SYMBOLS=SPY,QQQ,NVDA,TSLA,AAPL,AMD,META,AMZN,MSFT,GOOGL,PLTR,COIN
MNT_ALERT_SCAN_SECONDS=60
MNT_FUSION_SHORTLIST=4
MNT_STICKY_PRETRIGGER_LIMIT=2
MNT_PRETRIGGER_SCORE=72
MNT_PRETRIGGER_COVERAGE=55
MNT_ALERT_COOLDOWN_SECONDS=900
MNT_ALERT_STATE_MAX_AGE_SECONDS=14400
MNT_MAX_PRETRIGGER_ALERTS_PER_SCAN=3
MNT_MAX_READY_ALERTS_PER_SCAN=5
MNT_MAX_CONTRACT_COST=300
MNT_ALERT_START_MINUTE_ET=565
MNT_ALERT_END_MINUTE_ET=965
# MNT_ALERT_STATE_FILE=/home/airomair/mnt-data/mnt_alert_state.json

# Worker heartbeat / operations.
# MNT_WORKER_STATUS_FILE=/home/airomair/mnt-data/mnt_worker_status.json
MNT_WORKER_STALE_SECONDS=180

# Kronos CSV timestamps without an explicit UTC offset are treated as market time.
MNT_BAR_TIMEZONE=America/New_York
